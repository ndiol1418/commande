[Unit]
Description=Daaru Minam Cafe — API des commandes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=daaru
Group=daaru
WorkingDirectory=/opt/daaruminam/server
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

# le service n'a besoin d'écrire que dans son dossier data/
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/daaruminam/server/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=daaru-api

[Install]
WantedBy=multi-user.target
