# Copier en .env puis remplir. Ce fichier ne doit JAMAIS être versionné.

# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les commandes
OWNER_EMAIL=votre-adresse@exemple.com

# Expéditeur des e-mails. Le domaine doit être vérifié dans Resend.
MAIL_FROM=Daaru Minam Cafe <commandes@daaruminamcafe.com>

# Adresse de réponse montrée au client
MAIL_REPLY_TO=votre-adresse@exemple.com

# Port d'écoute local (Nginx fait le relais)
PORT=8787

# Jeton pour télécharger le fichier Excel : /api/export?cle=...
EXPORT_TOKEN=changez-moi

# Numéro WhatsApp affiché dans les e-mails (format international, sans +)
WHATSAPP=221775368231
